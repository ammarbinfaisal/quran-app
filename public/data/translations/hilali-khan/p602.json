{"106:1":[{"type":"annotation","text":"(It is a great Grace from Allâh)"},{"type":"text","text":" for the protection of the Quraish,"}],"106:2":[{"type":"annotation","text":"(And with all those Allâh’s Grace and Protections, We cause)"},{"type":"text","text":" the "},{"type":"annotation","text":"(Quraish)"},{"type":"text","text":" caravans to set forth safe in winter "},{"type":"annotation","text":"(to the south)"},{"type":"text","text":" and in summer "},{"type":"annotation","text":"(to the north without any fear)"},{"type":"text","text":","}],"106:3":[{"type":"text","text":"So let them worship "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" the Lord of this House "},{"type":"annotation","text":"(the Ka‘bah in Makkah)"},{"type":"text","text":","}],"106:4":[{"type":"annotation","text":"(He)"},{"type":"text","text":" Who has fed them against hunger, and has made them safe from fear."}],"107:1":[{"type":"text","text":"Have you seen him who denies the Recompense?"}],"107:2":[{"type":"text","text":"That is he who repulses the orphan "},{"type":"annotation","text":"(harshly)"},{"type":"text","text":","},{"type":"footnote","id":"155066","label":"1"}],"107:3":[{"type":"text","text":"And urges not on the feeding of Al-Miskîn "},{"type":"annotation","text":"(the poor)"},{"type":"text","text":","},{"type":"footnote","id":"155067","label":"1"}],"107:4":[{"type":"text","text":"So woe unto those performers of Salât "},{"type":"annotation","text":"(prayers)"},{"type":"text","text":" "},{"type":"annotation","text":"(hypocrites)"},{"type":"text","text":","}],"107:5":[{"type":"text","text":"Those who delay their Salât "},{"type":"annotation","text":"(prayer from their stated fixed times)"},{"type":"text","text":"."}],"107:6":[{"type":"text","text":"Those who do good deeds only to be seen "},{"type":"annotation","text":"(of men)"},{"type":"text","text":","}],"107:7":[{"type":"text","text":"And prevent Al-Mâ‘ûn "},{"type":"annotation","text":"(small kindnesses like salt, sugar, water)"},{"type":"text","text":"."}],"108:1":[{"type":"text","text":"Verily, We have granted you "},{"type":"annotation","text":"(O Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" Al-Kauthar "},{"type":"annotation","text":"(a river in Paradise)"},{"type":"text","text":"."},{"type":"footnote","id":"155068","label":"1"}],"108:2":[{"type":"text","text":"Therefore turn in prayer to your Lord and sacrifice "},{"type":"annotation","text":"(to Him only)"},{"type":"text","text":"."}],"108:3":[{"type":"text","text":"For he who hates you "},{"type":"annotation","text":"(O Muhammad صلى الله عليه وسلم)"},{"type":"text","text":", he will be cut off "},{"type":"annotation","text":"(from posterity and every good thing in this world and in the Hereafter)"},{"type":"text","text":"."},{"type":"footnote","id":"155069","label":"1"}]}