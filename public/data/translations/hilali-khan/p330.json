{"21:91":[{"type":"text","text":"And she who guarded her chastity "},{"type":"annotation","text":"[Virgin Maryam (Mary)]"},{"type":"text","text":": We breathed into "},{"type":"annotation","text":"(the sleeves of)"},{"type":"text","text":" her "},{"type":"annotation","text":"(shirt or garment)"},{"type":"text","text":" "},{"type":"annotation","text":"[through Our Rûh - Jibrîl (Gabriel)]"},{"type":"text","text":","},{"type":"footnote","id":"154725","label":"1"},{"type":"text","text":" and We made her and her son "},{"type":"annotation","text":"[‘Îsâ (Jesus)]"},{"type":"text","text":" a sign for Al-‘Âlamîn "},{"type":"annotation","text":"(the mankind and jinn)"},{"type":"text","text":"."}],"21:92":[{"type":"text","text":"Truly! This, your Ummah "},{"type":"annotation","text":"[Shari‘ah or religion (Islâmic Monotheism)]"},{"type":"text","text":" is one religion, and I am your Lord, therefore worship Me "},{"type":"annotation","text":"(Alone)"},{"type":"text","text":". "},{"type":"annotation","text":"[Tafsîr Ibn Kathîr]"}],"21:93":[{"type":"text","text":"But they have broken up and differed as regards their religion among themselves. "},{"type":"annotation","text":"(And)"},{"type":"text","text":" they all shall return to Us."}],"21:94":[{"type":"text","text":"So whoever does righteous good deeds while he is a believer "},{"type":"annotation","text":"(in the Oneness of Allâh - Islâmic Monotheism)"},{"type":"text","text":", his efforts will not be rejected. Verily We record it for him "},{"type":"annotation","text":"(in his Book of deeds)"},{"type":"text","text":"."},{"type":"footnote","id":"154726","label":"1"}],"21:95":[{"type":"text","text":"And a ban is laid on every town "},{"type":"annotation","text":"(population)"},{"type":"text","text":" which We have destroyed that they shall not return "},{"type":"annotation","text":"(to this world again, nor repent to Us)"},{"type":"text","text":"."}],"21:96":[{"type":"text","text":"Until, when Ya’jûj and Ma’jûj "},{"type":"annotation","text":"(Gog and Magog)"},{"type":"footnote","id":"154727","label":"1"},{"type":"text","text":" are let loose "},{"type":"annotation","text":"(from their barrier)"},{"type":"text","text":", and they swoop down from every mound."}],"21:97":[{"type":"text","text":"And the true promise "},{"type":"annotation","text":"(Day of Resurrection)"},{"type":"text","text":" shall draw near "},{"type":"annotation","text":"(of fulfillment)"},{"type":"text","text":". Then "},{"type":"annotation","text":"(when mankind is resurrected from their graves)"},{"type":"text","text":", you shall see the eyes of the disbelievers fixedly staring in horror. "},{"type":"annotation","text":"(They will say)"},{"type":"text","text":": \"Woe to us! We were indeed heedless of this - nay, but we were Zâlimûn "},{"type":"annotation","text":"(polytheists and wrong-doers)"},{"type":"text","text":".\""}],"21:98":[{"type":"text","text":"Certainly you "},{"type":"annotation","text":"(disbelievers)"},{"type":"text","text":" and that which you are worshipping now besides Allâh, are "},{"type":"annotation","text":"(but)"},{"type":"text","text":" fuel for Hell! "},{"type":"annotation","text":"(Surely)"},{"type":"text","text":", you will enter it."},{"type":"footnote","id":"154728","label":"1"}],"21:99":[{"type":"text","text":"Had these "},{"type":"annotation","text":"(idols)"},{"type":"text","text":" been âlihah "},{"type":"annotation","text":"(gods)"},{"type":"text","text":", they would not have entered there "},{"type":"annotation","text":"(Hell)"},{"type":"text","text":", and all of them will abide therein."}],"21:100":[{"type":"text","text":"Therein they will be breathing out with deep sighs and roaring and therein they will hear not."},{"type":"footnote","id":"154729","label":"1"}],"21:101":[{"type":"text","text":"Verily, those for whom the good has preceded from Us, they will be removed far therefrom "},{"type":"annotation","text":"(Hell)"},{"type":"text","text":" "},{"type":"annotation","text":"[e.g. ‘Îsâ (Jesus), son of Maryam (Mary); ‘Uzair (Ezra)]"},{"type":"text","text":"."}]}