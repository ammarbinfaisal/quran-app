{"56:77":[{"type":"text","text":"That "},{"type":"annotation","text":"(this)"},{"type":"text","text":" is indeed an honourable recitation "},{"type":"annotation","text":"(the Noble Qur’ân)"},{"type":"text","text":"."}],"56:78":[{"type":"text","text":"In a Book well-guarded "},{"type":"annotation","text":"(with Allâh in the heaven i.e. Al-Lauh Al-Mahfûz )"},{"type":"text","text":"."}],"56:79":[{"type":"text","text":"Which "},{"type":"annotation","text":"(that Book with Allâh)"},{"type":"text","text":" none can touch but the purified "},{"type":"annotation","text":"(i.e. the angels)"},{"type":"text","text":"."}],"56:80":[{"type":"text","text":"A Revelation "},{"type":"annotation","text":"(this Qur’ân)"},{"type":"text","text":" from the Lord of the ‘Âlamîn "},{"type":"annotation","text":"(mankind, jinn and all that exists)"},{"type":"text","text":"."}],"56:81":[{"type":"text","text":"Is it such a talk "},{"type":"annotation","text":"(this Qur’ân)"},{"type":"text","text":" that you "},{"type":"annotation","text":"(disbelievers)"},{"type":"text","text":" deny?"}],"56:82":[{"type":"text","text":"And instead "},{"type":"annotation","text":"(of thanking Allâh)"},{"type":"text","text":" for the provision He gives you, you deny "},{"type":"annotation","text":"(Him by disbelief)"},{"type":"text","text":"!"}],"56:83":[{"type":"text","text":"Then why do you not "},{"type":"annotation","text":"(intervene)"},{"type":"text","text":" when "},{"type":"annotation","text":"(the soul of a dying person)"},{"type":"text","text":" reaches the throat?"}],"56:84":[{"type":"text","text":"And you at the moment are looking on,"}],"56:85":[{"type":"text","text":"But We "},{"type":"annotation","text":"(i.e. Our angels who take the soul)"},{"type":"text","text":" are nearer to him than you, but you see not, "},{"type":"annotation","text":"(Tafsir At-Tabarî)"}],"56:86":[{"type":"text","text":"Then why do you not - if you are exempt from the reckoning and recompense "},{"type":"annotation","text":"(punishment)"},{"type":"text","text":" -"}],"56:87":[{"type":"text","text":"Bring back the soul "},{"type":"annotation","text":"(to its body)"},{"type":"text","text":", if you are truthful?"}],"56:88":[{"type":"text","text":"Then, if he "},{"type":"annotation","text":"(the dying person)"},{"type":"text","text":" be of the Muqarrabûn "},{"type":"annotation","text":"(those brought near to Allâh)"},{"type":"text","text":","}],"56:89":[{"type":"annotation","text":"(There is for him)"},{"type":"text","text":" rest and provision, and a Garden of Delights "},{"type":"annotation","text":"(Paradise)"},{"type":"text","text":"."}],"56:90":[{"type":"text","text":"And if he "},{"type":"annotation","text":"(the dying person)"},{"type":"text","text":" be of those on the Right Hand,"}],"56:91":[{"type":"text","text":"Then there is safety and peace "},{"type":"annotation","text":"(from the Punishment of Allâh)"},{"type":"text","text":" for those on the right Hand."}],"56:92":[{"type":"text","text":"But if he "},{"type":"annotation","text":"(the dying person)"},{"type":"text","text":" be of the denying "},{"type":"annotation","text":"(of the Resurrection)"},{"type":"text","text":", the erring "},{"type":"annotation","text":"(away from the Right Path of Islâmic Monotheism)"},{"type":"text","text":","}],"56:93":[{"type":"text","text":"Then for him is an entertainment with boiling water."}],"56:94":[{"type":"text","text":"And burning in Hell-fire."}],"56:95":[{"type":"text","text":"Verily, this! This is an absolute Truth with certainty."}],"56:96":[{"type":"text","text":"So glorify with praises the Name of your Lord, the Most Great."}],"57:1":[{"type":"text","text":"Whatsoever is in the heavens and the earth glorifies Allâh - and He is the All-Mighty, All-Wise."}],"57:2":[{"type":"text","text":"His is the kingdom of the heavens and the earth. It is He Who gives life and causes death: and He is Able to do all things."}],"57:3":[{"type":"text","text":"He is the First "},{"type":"annotation","text":"(nothing is before Him)"},{"type":"text","text":" and the Last "},{"type":"annotation","text":"(nothing is after Him)"},{"type":"text","text":", the Most High "},{"type":"annotation","text":"(nothing is above Him)"},{"type":"text","text":" and the Most Near "},{"type":"annotation","text":"(nothing is nearer than Him)"},{"type":"text","text":". And He is the All-Knower of every thing."}]}