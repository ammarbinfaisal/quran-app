{"1:1":[{"type":"text","text":"In the Name of Allâh, the Most Gracious, the Most Merciful"}],"1:2":[{"type":"text","text":"All the praises and thanks be to Allâh, the Lord"},{"type":"footnote","id":"154319","label":"1"},{"type":"text","text":" of the ‘Âlamîn "},{"type":"annotation","text":"(mankind, jinn and all that exists)"},{"type":"text","text":"."},{"type":"footnote","id":"154320","label":"2"}],"1:3":[{"type":"text","text":"The Most Gracious, the Most Merciful."}],"1:4":[{"type":"text","text":"The Only Owner "},{"type":"annotation","text":"(and the Only Ruling Judge)"},{"type":"text","text":" of the Day of Recompense "},{"type":"annotation","text":"(i.e. the Day of Resurrection)"}],"1:5":[{"type":"text","text":"You "},{"type":"annotation","text":"(Alone)"},{"type":"text","text":" we worship, and You "},{"type":"annotation","text":"(Alone)"},{"type":"text","text":" we ask for help "},{"type":"annotation","text":"(for each and everything)"},{"type":"text","text":"."}],"1:6":[{"type":"text","text":"Guide us to the Straight Way."},{"type":"footnote","id":"154321","label":"1"}],"1:7":[{"type":"text","text":"The Way of those on whom You have bestowed Your Grace"},{"type":"footnote","id":"154322","label":"1"},{"type":"text","text":" , not "},{"type":"annotation","text":"(the way)"},{"type":"text","text":" of those who earned Your Anger "},{"type":"footnote","id":"154323","label":"2"},{"type":"text","text":" "},{"type":"annotation","text":"(i.e. those who knew the Truth, but did not follow it)"},{"type":"text","text":" nor of those who went astray "},{"type":"annotation","text":"(i.e. those who did not follow the Truth out of ignorance and error)"},{"type":"text","text":". "},{"type":"footnote","id":"154324","label":"3"},{"type":"text","text":", "},{"type":"footnote","id":"154325","label":"4"}]}