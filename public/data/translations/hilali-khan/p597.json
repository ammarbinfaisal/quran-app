{"95:1":[{"type":"text","text":"By the fig, and the olive."}],"95:2":[{"type":"text","text":"By Mount Sinai."}],"95:3":[{"type":"text","text":"By this city of security "},{"type":"annotation","text":"(Makkah)"},{"type":"text","text":"."},{"type":"footnote","id":"155056","label":"1"}],"95:4":[{"type":"text","text":"Verily, We created man in the best stature "},{"type":"annotation","text":"(mould)"},{"type":"text","text":"."}],"95:5":[{"type":"text","text":"Then We reduced him to the lowest of the low."}],"95:6":[{"type":"text","text":"Save those who believe "},{"type":"annotation","text":"(in Islâmic Monotheism)"},{"type":"text","text":" and do righteous deeds. Then they shall have a reward without end "},{"type":"annotation","text":"(Paradise)"},{"type":"text","text":"."}],"95:7":[{"type":"text","text":"Then what "},{"type":"annotation","text":"(or who)"},{"type":"text","text":" causes you "},{"type":"annotation","text":"(O disbelievers)"},{"type":"text","text":" to deny the Recompense "},{"type":"annotation","text":"(i.e. the Day of Resurrection)"},{"type":"text","text":"?"}],"95:8":[{"type":"text","text":"Is not Allâh the Best of judges?"}],"96:1":[{"type":"text","text":"Read! In the Name of your Lord Who has created "},{"type":"annotation","text":"(all that exists)"},{"type":"text","text":"."}],"96:2":[{"type":"text","text":"He has created man from a clot "},{"type":"annotation","text":"(a piece of thick coagulated blood)"},{"type":"text","text":"."}],"96:3":[{"type":"text","text":"Read! And your Lord is the Most Generous."}],"96:4":[{"type":"text","text":"Who has taught "},{"type":"annotation","text":"(the writing)"},{"type":"text","text":" by the pen."}],"96:5":[{"type":"text","text":"He has taught man that which he knew not."}],"96:6":[{"type":"text","text":"Nay! Verily, man does transgress "},{"type":"annotation","text":"(in disbelief and evil deed)"},{"type":"text","text":"."}],"96:7":[{"type":"text","text":"Because he considers himself self-sufficient."}],"96:8":[{"type":"text","text":"Surely, unto your Lord is the return."}],"96:9":[{"type":"text","text":"Have you "},{"type":"annotation","text":"(O Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" seen him "},{"type":"annotation","text":"(i.e. Abû Jahl)"},{"type":"text","text":" who prevents"}],"96:10":[{"type":"text","text":"A slave "},{"type":"annotation","text":"(Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" when he prays?"}],"96:11":[{"type":"text","text":"Tell me if he "},{"type":"annotation","text":"(Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" is on the guidance "},{"type":"annotation","text":"(of Allâh)"}],"96:12":[{"type":"text","text":"Or enjoins piety!"}],"96:13":[{"type":"text","text":"Tell me if he "},{"type":"annotation","text":"(Abû Jahl)"},{"type":"text","text":" denies "},{"type":"annotation","text":"(the truth, i.e. this Qur’ân)"},{"type":"text","text":" and turns away?"}],"96:14":[{"type":"text","text":"Knows he not that Allâh does see "},{"type":"annotation","text":"(what he does)"},{"type":"text","text":"?"}],"96:15":[{"type":"text","text":"Nay! If he "},{"type":"annotation","text":"(Abû Jahl)"},{"type":"text","text":" ceases not, We will catch him by the forelock -"}],"96:16":[{"type":"text","text":"A lying, sinful forelock!"}],"96:17":[{"type":"text","text":"Then let him call upon his council "},{"type":"annotation","text":"(of helpers)"},{"type":"text","text":"."}],"96:18":[{"type":"text","text":"We will call out the guards of Hell "},{"type":"annotation","text":"(to deal with him)"},{"type":"text","text":"!"}],"96:19":[{"type":"text","text":"Nay! "},{"type":"annotation","text":"(O Muhammad صلى الله عليه وسلم)"},{"type":"text","text":"! Do not obey him "},{"type":"annotation","text":"(Abû Jahl)"},{"type":"text","text":". Fall prostrate and draw near to Allâh!"}]}