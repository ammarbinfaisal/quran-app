{"53:45":[{"type":"text","text":"And that He "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" creates the pairs, male and female,"}],"53:46":[{"type":"text","text":"From Nutfah "},{"type":"annotation","text":"(drops of semen - male and female discharges)"},{"type":"text","text":" when it is emitted."}],"53:47":[{"type":"text","text":"And that upon Him "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" is another bringing forth "},{"type":"annotation","text":"(Resurrection)"},{"type":"text","text":"."}],"53:48":[{"type":"text","text":"And that it is He "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" Who gives much or a little "},{"type":"annotation","text":"(of wealth and contentment)"}],"53:49":[{"type":"text","text":"And that He "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" is the Lord of Sirius "},{"type":"annotation","text":"(the star which the pagan Arabs used to worship)"},{"type":"text","text":"."}],"53:50":[{"type":"text","text":"And that it is He "},{"type":"annotation","text":"(Allâh)"},{"type":"text","text":" Who destroyed the former ‘Âd "},{"type":"annotation","text":"(people)"},{"type":"text","text":","}],"53:51":[{"type":"text","text":"And Thamûd "},{"type":"annotation","text":"(people)"},{"type":"text","text":": He spared none of them."}],"53:52":[{"type":"text","text":"And the people of Nûh "},{"type":"annotation","text":"(Noah)"},{"type":"text","text":" aforetime. Verily, they were more unjust and more rebellious and transgressing "},{"type":"annotation","text":"[in disobeying Allâh and His Messenger Nûh (Noah) عليه السلام]"},{"type":"text","text":"."}],"53:53":[{"type":"text","text":"And He destroyed the overthrown cities "},{"type":"annotation","text":"[of Sodom to which Prophet Lût (Lot) was sent]"},{"type":"text","text":"."}],"53:54":[{"type":"text","text":"So there covered them that which did cover "},{"type":"annotation","text":"(i.e. torment with stones)"},{"type":"text","text":"."}],"53:55":[{"type":"text","text":"Then which of the Graces of your Lord "},{"type":"annotation","text":"(O man!)"},{"type":"text","text":" will you doubt?"}],"53:56":[{"type":"text","text":"This "},{"type":"annotation","text":"(Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" is a warner "},{"type":"annotation","text":"(Messenger)"},{"type":"text","text":" of the "},{"type":"annotation","text":"(series of)"},{"type":"text","text":" warners "},{"type":"annotation","text":"(Messengers)"},{"type":"text","text":" of old."},{"type":"footnote","id":"154952","label":"1"}],"53:57":[{"type":"text","text":"The Day of Resurrection draws near."}],"53:58":[{"type":"text","text":"None besides Allâh can avert it "},{"type":"annotation","text":"(or advance it or delay it)"},{"type":"text","text":"."}],"53:59":[{"type":"text","text":"Do you then wonder at this recitation "},{"type":"annotation","text":"(the Qur’ân)"},{"type":"text","text":"?"}],"53:60":[{"type":"text","text":"And you laugh at it and weep not,"}],"53:61":[{"type":"text","text":"Wasting your "},{"type":"annotation","text":"(precious)"},{"type":"text","text":" lifetime in pastime and amusements "},{"type":"annotation","text":"(singing, etc.)"},{"type":"text","text":"."}],"53:62":[{"type":"text","text":"So fall you down in prostration to Allâh and worship Him "},{"type":"annotation","text":"(Alone)"},{"type":"text","text":"."}],"54:1":[{"type":"text","text":"The Hour has drawn near, and the moon has been cleft asunder "},{"type":"annotation","text":"(the people of Makkah requested Prophet Muhammad صلى الله عليه وسلم to show them a miracle, so he showed them the splitting of the moon)"},{"type":"text","text":"."},{"type":"footnote","id":"154953","label":"1"}],"54:2":[{"type":"text","text":"And if they see a sign, they turn away, and say: \"This is continuous magic.\""}],"54:3":[{"type":"text","text":"They belied "},{"type":"annotation","text":"(the Verses of Allâh - this Qur’ân)"},{"type":"text","text":", and followed their own lusts. And every matter will be settled "},{"type":"annotation","text":"(according to the kind of deeds: good deeds will take their doers to Paradise, and similarly evil deeds will take their doers to Hell)"},{"type":"text","text":"."}],"54:4":[{"type":"text","text":"And indeed there has come to them news "},{"type":"annotation","text":"(in this Qur’ân)"},{"type":"text","text":" wherein there is "},{"type":"annotation","text":"(enough warning)"},{"type":"text","text":" to check "},{"type":"annotation","text":"(them from evil)"},{"type":"text","text":","}],"54:5":[{"type":"text","text":"Perfect wisdom "},{"type":"annotation","text":"(this Qur’ân)"},{"type":"text","text":", but "},{"type":"annotation","text":"(the preaching of)"},{"type":"text","text":" warners benefit them not."}],"54:6":[{"type":"text","text":"So "},{"type":"annotation","text":"(O Muhammad صلى الله عليه وسلم)"},{"type":"text","text":" withdraw from them. The Day that the caller will call "},{"type":"annotation","text":"(them)"},{"type":"text","text":" to a terrible thing."}]}