{"78:31":[{"type":"text","text":"Indeed, for the righteous is attainment"},{"type":"footnote","id":"197678","label":"1"},{"type":"text","text":" -"}],"78:32":[{"type":"text","text":"Gardens and grapevines."}],"78:33":[{"type":"text","text":"And full-breasted "},{"type":"annotation","text":"[companions]"},{"type":"text","text":" of equal age."}],"78:34":[{"type":"text","text":"And a full cup."},{"type":"footnote","id":"197679","label":"1"}],"78:35":[{"type":"text","text":"No ill speech will they hear therein or any falsehood -"}],"78:36":[{"type":"annotation","text":"[As]"},{"type":"text","text":" reward from your Lord, "},{"type":"annotation","text":"[a generous]"},{"type":"text","text":" gift "},{"type":"annotation","text":"[made due by]"},{"type":"text","text":" account,"},{"type":"footnote","id":"197680","label":"1"}],"78:37":[{"type":"annotation","text":"[From]"},{"type":"text","text":" the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him "},{"type":"annotation","text":"[authority for]"},{"type":"text","text":" speech."},{"type":"footnote","id":"197681","label":"1"}],"78:38":[{"type":"text","text":"The Day that the Spirit "},{"type":"annotation","text":"[i.e., Gabriel]"},{"type":"text","text":" and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct."}],"78:39":[{"type":"text","text":"That is the True "},{"type":"annotation","text":"[i.e., certain]"},{"type":"text","text":" Day; so he who wills may take to his Lord a "},{"type":"annotation","text":"[way of]"},{"type":"text","text":" return."},{"type":"footnote","id":"197682","label":"1"}],"78:40":[{"type":"text","text":"Indeed, We have warned you of an impending punishment on the Day when a man will observe what his hands have put forth"},{"type":"footnote","id":"197683","label":"1"},{"type":"text","text":" and the disbeliever will say, \"Oh, I wish that I were dust!\""}],"79:1":[{"type":"text","text":"By those "},{"type":"annotation","text":"[angels]"},{"type":"text","text":" who extract with violence"},{"type":"footnote","id":"197684","label":"1"}],"79:2":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" those who remove with ease"},{"type":"footnote","id":"197685","label":"1"}],"79:3":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" those who glide "},{"type":"annotation","text":"[as if]"},{"type":"text","text":" swimming"},{"type":"footnote","id":"197686","label":"1"}],"79:4":[{"type":"text","text":"And those who race each other in a race"},{"type":"footnote","id":"197687","label":"1"}],"79:5":[{"type":"text","text":"And those who arrange "},{"type":"annotation","text":"[each]"},{"type":"text","text":" matter,"},{"type":"footnote","id":"197688","label":"1"}],"79:6":[{"type":"text","text":"On the Day the blast "},{"type":"annotation","text":"[of the Horn]"},{"type":"text","text":" will convulse "},{"type":"annotation","text":"[creation]"},{"type":"text","text":","}],"79:7":[{"type":"text","text":"There will follow it the subsequent "},{"type":"annotation","text":"[one]"},{"type":"text","text":"."}],"79:8":[{"type":"text","text":"Hearts,"},{"type":"footnote","id":"197689","label":"1"},{"type":"text","text":" that Day, will tremble,"}],"79:9":[{"type":"text","text":"Their eyes"},{"type":"footnote","id":"197690","label":"1"},{"type":"text","text":" humbled."}],"79:10":[{"type":"text","text":"They are "},{"type":"annotation","text":"[presently]"},{"type":"text","text":" saying, \"Will we indeed be returned to "},{"type":"annotation","text":"[our]"},{"type":"text","text":" former state "},{"type":"annotation","text":"[of life]"},{"type":"text","text":"?"}],"79:11":[{"type":"text","text":"Even if we should be decayed bones?\""},{"type":"footnote","id":"197691","label":"1"}],"79:12":[{"type":"text","text":"They say, \"That, then, would be a losing return.\""},{"type":"footnote","id":"197692","label":"1"}],"79:13":[{"type":"text","text":"Indeed, it will be but one shout,"}],"79:14":[{"type":"text","text":"And suddenly they will be "},{"type":"annotation","text":"[alert]"},{"type":"text","text":" upon the earth's surface."}],"79:15":[{"type":"text","text":"Has there reached you the story of Moses? -"}]}