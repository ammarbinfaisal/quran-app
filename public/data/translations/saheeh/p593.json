{"89:1":[{"type":"text","text":"By the dawn"}],"89:2":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" ten nights"},{"type":"footnote","id":"197754","label":"1"}],"89:3":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the even "},{"type":"annotation","text":"[number]"},{"type":"text","text":" and the odd"}],"89:4":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the night when it passes,"}],"89:5":[{"type":"text","text":"Is there "},{"type":"annotation","text":"[not]"},{"type":"text","text":" in "},{"type":"annotation","text":"[all]"},{"type":"text","text":" that an oath "},{"type":"annotation","text":"[sufficient]"},{"type":"text","text":" for one of perception?"},{"type":"footnote","id":"197755","label":"1"}],"89:6":[{"type":"text","text":"Have you not considered how your Lord dealt with ʿAad -"}],"89:7":[{"type":"annotation","text":"[With]"},{"type":"text","text":" Iram"},{"type":"footnote","id":"197757","label":"1"},{"type":"text","text":" - who had lofty pillars,"},{"type":"footnote","id":"197756","label":"2"}],"89:8":[{"type":"text","text":"The likes of whom had never been created in the land?"}],"89:9":[{"type":"text","text":"And "},{"type":"annotation","text":"[with]"},{"type":"text","text":" Thamūd, who carved out the rocks in the valley?"}],"89:10":[{"type":"text","text":"And "},{"type":"annotation","text":"[with]"},{"type":"text","text":" Pharaoh, owner of the stakes?"},{"type":"footnote","id":"197758","label":"1"}],"89:11":[{"type":"annotation","text":"[All of]"},{"type":"text","text":" whom oppressed within the lands"}],"89:12":[{"type":"text","text":"And increased therein the corruption."}],"89:13":[{"type":"text","text":"So your Lord poured upon them a scourge of punishment."}],"89:14":[{"type":"text","text":"Indeed, your Lord is in observation."}],"89:15":[{"type":"text","text":"And as for man, when his Lord tries him and "},{"type":"annotation","text":"[thus]"},{"type":"text","text":" is generous to him and favors him, he says, \"My Lord has honored me.\""},{"type":"footnote","id":"197759","label":"1"}],"89:16":[{"type":"text","text":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\""}],"89:17":[{"type":"text","text":"No!"},{"type":"footnote","id":"197760","label":"1"},{"type":"text","text":" But you do not honor the orphan"}],"89:18":[{"type":"text","text":"And you do not encourage one another to feed the poor."}],"89:19":[{"type":"text","text":"And you consume inheritance, devouring "},{"type":"annotation","text":"[it]"},{"type":"text","text":" altogether,"},{"type":"footnote","id":"197761","label":"1"}],"89:20":[{"type":"text","text":"And you love wealth with immense love."}],"89:21":[{"type":"text","text":"No! When the earth has been leveled - pounded and crushed"}],"89:22":[{"type":"text","text":"And your Lord has come"},{"type":"footnote","id":"197762","label":"1"},{"type":"text","text":" and the angels, rank upon rank,"}],"89:23":[{"type":"text","text":"And brought "},{"type":"annotation","text":"[within view]"},{"type":"text","text":", that Day, is Hell - that Day, man will remember, but how "},{"type":"annotation","text":"[i.e., what good]"},{"type":"text","text":" to him will be the remembrance?"}]}