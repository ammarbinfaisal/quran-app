{"80:1":[{"type":"text","text":"He "},{"type":"annotation","text":"[i.e., the Prophet (ﷺ) ]"},{"type":"text","text":" frowned and turned away"}],"80:2":[{"type":"text","text":"Because there came to him the blind man,"},{"type":"footnote","id":"197703","label":"1"},{"type":"text","text":" "},{"type":"annotation","text":"[interrupting]"},{"type":"text","text":"."}],"80:3":[{"type":"text","text":"But what would make you perceive, "},{"type":"annotation","text":"[O Muḥammad]"},{"type":"text","text":", that perhaps he might be purified"},{"type":"footnote","id":"197704","label":"1"}],"80:4":[{"type":"text","text":"Or be reminded and the remembrance would benefit him?"}],"80:5":[{"type":"text","text":"As for he who thinks himself without need,"},{"type":"footnote","id":"197705","label":"1"}],"80:6":[{"type":"text","text":"To him you give attention."}],"80:7":[{"type":"text","text":"And not upon you "},{"type":"annotation","text":"[is any blame]"},{"type":"text","text":" if he will not be purified."},{"type":"footnote","id":"197706","label":"1"}],"80:8":[{"type":"text","text":"But as for he who came to you striving "},{"type":"annotation","text":"[for knowledge]"}],"80:9":[{"type":"text","text":"While he fears "},{"type":"annotation","text":"[Allāh]"},{"type":"text","text":","}],"80:10":[{"type":"text","text":"From him you are distracted."}],"80:11":[{"type":"text","text":"No! Indeed, they "},{"type":"annotation","text":"[i.e., these verses]"},{"type":"text","text":" are a reminder;"}],"80:12":[{"type":"text","text":"So whoever wills may remember it."},{"type":"footnote","id":"197707","label":"1"}],"80:13":[{"type":"annotation","text":"[It is recorded]"},{"type":"text","text":" in honored sheets,"}],"80:14":[{"type":"text","text":"Exalted and purified,"}],"80:15":[{"type":"annotation","text":"[Carried]"},{"type":"text","text":" by the hands of messenger-angels,"}],"80:16":[{"type":"text","text":"Noble and dutiful."}],"80:17":[{"type":"text","text":"Destroyed "},{"type":"annotation","text":"[i.e., cursed]"},{"type":"text","text":" is man;"},{"type":"footnote","id":"197708","label":"1"},{"type":"text","text":" how disbelieving is he."}],"80:18":[{"type":"text","text":"From what thing "},{"type":"annotation","text":"[i.e., substance]"},{"type":"text","text":" did He create him?"}],"80:19":[{"type":"text","text":"From a sperm-drop He created him and destined for him;"},{"type":"footnote","id":"197709","label":"1"}],"80:20":[{"type":"text","text":"Then He eased the way for him;"},{"type":"footnote","id":"197710","label":"1"}],"80:21":[{"type":"text","text":"Then He causes his death and provides a grave for him."},{"type":"footnote","id":"197711","label":"1"}],"80:22":[{"type":"text","text":"Then when He wills, He will resurrect him."}],"80:23":[{"type":"text","text":"No! He "},{"type":"annotation","text":"[i.e., man]"},{"type":"text","text":" has not yet accomplished what He commanded him."}],"80:24":[{"type":"text","text":"Then let mankind look at his food -"}],"80:25":[{"type":"text","text":"How We poured down water in torrents,"}],"80:26":[{"type":"text","text":"Then We broke open the earth, splitting "},{"type":"annotation","text":"[it with sprouts]"},{"type":"text","text":","}],"80:27":[{"type":"text","text":"And caused to grow within it grain"}],"80:28":[{"type":"text","text":"And grapes and herbage"}],"80:29":[{"type":"text","text":"And olive and palm trees"}],"80:30":[{"type":"text","text":"And gardens of dense shrubbery"}],"80:31":[{"type":"text","text":"And fruit and grass -"}],"80:32":[{"type":"annotation","text":"[As]"},{"type":"text","text":" enjoyment "},{"type":"annotation","text":"[i.e., provision]"},{"type":"text","text":" for you and your grazing livestock."}],"80:33":[{"type":"text","text":"But when there comes the Deafening Blast"},{"type":"footnote","id":"197712","label":"1"}],"80:34":[{"type":"text","text":"On the Day a man will flee from his brother"}],"80:35":[{"type":"text","text":"And his mother and his father"}],"80:36":[{"type":"text","text":"And his wife and his children,"}],"80:37":[{"type":"text","text":"For every man, that Day, will be a matter adequate for him."},{"type":"footnote","id":"197713","label":"1"}],"80:38":[{"type":"annotation","text":"[Some]"},{"type":"text","text":" faces, that Day, will be bright -"}],"80:39":[{"type":"text","text":"Laughing, rejoicing at good news."}],"80:40":[{"type":"text","text":"And "},{"type":"annotation","text":"[other]"},{"type":"text","text":" faces, that Day, will have upon them dust."}],"80:41":[{"type":"text","text":"Blackness will cover them."}],"80:42":[{"type":"text","text":"Those are the disbelievers, the wicked ones."}]}