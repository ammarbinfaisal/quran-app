{"81:1":[{"type":"text","text":"When the sun is wrapped up "},{"type":"annotation","text":"[in darkness]"}],"81:2":[{"type":"text","text":"And when the stars fall, dispersing,"}],"81:3":[{"type":"text","text":"And when the mountains are removed"}],"81:4":[{"type":"text","text":"And when full-term she-camels"},{"type":"footnote","id":"197714","label":"1"},{"type":"text","text":" are neglected"}],"81:5":[{"type":"text","text":"And when the wild beasts are gathered"}],"81:6":[{"type":"text","text":"And when the seas are filled with flame"},{"type":"footnote","id":"197715","label":"1"}],"81:7":[{"type":"text","text":"And when the souls are paired"},{"type":"footnote","id":"197716","label":"1"}],"81:8":[{"type":"text","text":"And when the girl "},{"type":"annotation","text":"[who was]"},{"type":"text","text":" buried alive is asked"}],"81:9":[{"type":"text","text":"For what sin she was killed"}],"81:10":[{"type":"text","text":"And when the pages"},{"type":"footnote","id":"197717","label":"1"},{"type":"text","text":" are spread "},{"type":"annotation","text":"[i.e., made public]"}],"81:11":[{"type":"text","text":"And when the sky is stripped away"}],"81:12":[{"type":"text","text":"And when Hellfire is set ablaze"}],"81:13":[{"type":"text","text":"And when Paradise is brought near,"}],"81:14":[{"type":"text","text":"A soul will "},{"type":"annotation","text":"[then]"},{"type":"text","text":" know what it has brought "},{"type":"annotation","text":"[with it]"},{"type":"text","text":"."},{"type":"footnote","id":"197718","label":"1"}],"81:15":[{"type":"text","text":"So I swear by the retreating stars -"}],"81:16":[{"type":"text","text":"Those that run "},{"type":"annotation","text":"[their courses]"},{"type":"text","text":" and disappear "},{"type":"annotation","text":"[i.e., set]"}],"81:17":[{"type":"text","text":"And by the night as it closes in"},{"type":"footnote","id":"197719","label":"1"}],"81:18":[{"type":"text","text":"And by the dawn when it breathes "},{"type":"annotation","text":"[i.e., stirs]"}],"81:19":[{"type":"annotation","text":"[That]"},{"type":"text","text":" indeed, it "},{"type":"annotation","text":"[i.e., the Qur’ān]"},{"type":"text","text":" is a word "},{"type":"annotation","text":"[conveyed by]"},{"type":"text","text":" a noble messenger "},{"type":"annotation","text":"[i.e., Gabriel]"}],"81:20":[{"type":"annotation","text":"[Who is]"},{"type":"text","text":" possessed of power and with the Owner of the Throne, secure "},{"type":"annotation","text":"[in position]"},{"type":"text","text":","}],"81:21":[{"type":"text","text":"Obeyed there "},{"type":"annotation","text":"[in the heavens]"},{"type":"text","text":" and trustworthy."}],"81:22":[{"type":"text","text":"And your companion "},{"type":"annotation","text":"[i.e., Prophet Muḥammad (ﷺ) ]"},{"type":"text","text":" is not "},{"type":"annotation","text":"[at all]"},{"type":"text","text":" mad."},{"type":"footnote","id":"197720","label":"1"}],"81:23":[{"type":"text","text":"And he has already seen him "},{"type":"annotation","text":"[i.e., Gabriel]"},{"type":"text","text":" in the clear horizon."},{"type":"footnote","id":"197721","label":"1"}],"81:24":[{"type":"text","text":"And he "},{"type":"annotation","text":"[i.e., Muḥammad (ﷺ)]"},{"type":"text","text":" is not a withholder of "},{"type":"annotation","text":"[knowledge of]"},{"type":"text","text":" the unseen."},{"type":"footnote","id":"197722","label":"1"}],"81:25":[{"type":"text","text":"And it "},{"type":"annotation","text":"[i.e., the Qur’ān]"},{"type":"text","text":" is not the word of a devil, expelled "},{"type":"annotation","text":"[from the heavens]"},{"type":"text","text":"."}],"81:26":[{"type":"text","text":"So where are you going?"},{"type":"footnote","id":"197723","label":"1"}],"81:27":[{"type":"text","text":"It is not except a reminder to the worlds"}],"81:28":[{"type":"text","text":"For whoever wills among you to take a right course."}],"81:29":[{"type":"text","text":"And you do not will except that Allāh wills - Lord of the worlds."}]}