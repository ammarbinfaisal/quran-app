{"91:1":[{"type":"text","text":"By the sun and its brightness"}],"91:2":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the moon when it follows it"}],"91:3":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the day when it displays it"},{"type":"footnote","id":"197770","label":"1"}],"91:4":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the night when it covers "},{"type":"annotation","text":"[i.e., conceals]"},{"type":"text","text":" it"}],"91:5":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the sky and He who constructed it"}],"91:6":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the earth and He who spread it"}],"91:7":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the soul and He who proportioned it"},{"type":"footnote","id":"197771","label":"1"}],"91:8":[{"type":"text","text":"And inspired it "},{"type":"annotation","text":"[with discernment of]"},{"type":"text","text":" its wickedness and its righteousness,"}],"91:9":[{"type":"text","text":"He has succeeded who purifies it,"}],"91:10":[{"type":"text","text":"And he has failed who instills it "},{"type":"annotation","text":"[with corruption]"},{"type":"text","text":"."}],"91:11":[{"type":"text","text":"Thamūd denied "},{"type":"annotation","text":"[their prophet]"},{"type":"text","text":" by reason of their transgression,"}],"91:12":[{"type":"text","text":"When the most wretched of them was sent forth."},{"type":"footnote","id":"197772","label":"1"}],"91:13":[{"type":"text","text":"And the messenger of Allāh "},{"type":"annotation","text":"[i.e., Ṣāliḥ]"},{"type":"text","text":" said to them, \""},{"type":"annotation","text":"[Do not harm]"},{"type":"text","text":" the she-camel of Allāh or "},{"type":"annotation","text":"[prevent her from]"},{"type":"text","text":" her drink.\""}],"91:14":[{"type":"text","text":"But they denied him and hamstrung"},{"type":"footnote","id":"197773","label":"1"},{"type":"text","text":" her. So their Lord brought down upon them destruction for their sin and made it equal "},{"type":"annotation","text":"[upon all of them]"},{"type":"text","text":"."}],"91:15":[{"type":"text","text":"And He does not fear the consequence thereof."},{"type":"footnote","id":"197774","label":"1"}],"92:1":[{"type":"text","text":"By the night when it covers"},{"type":"footnote","id":"197775","label":"1"}],"92:2":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the day when it appears"}],"92:3":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" He who created the male and female,"}],"92:4":[{"type":"text","text":"Indeed, your efforts are diverse."}],"92:5":[{"type":"text","text":"As for he who gives and fears Allāh"}],"92:6":[{"type":"text","text":"And believes in the best "},{"type":"annotation","text":"[reward]"},{"type":"text","text":","}],"92:7":[{"type":"text","text":"We will ease him toward ease."}],"92:8":[{"type":"text","text":"But as for he who withholds and considers himself free of need"}],"92:9":[{"type":"text","text":"And denies the best "},{"type":"annotation","text":"[reward]"},{"type":"text","text":","}],"92:10":[{"type":"text","text":"We will ease him toward difficulty."}],"92:11":[{"type":"text","text":"And what will his wealth avail him when he falls?"},{"type":"footnote","id":"197776","label":"1"}],"92:12":[{"type":"text","text":"Indeed, "},{"type":"annotation","text":"[incumbent]"},{"type":"text","text":" upon Us is guidance."}],"92:13":[{"type":"text","text":"And indeed, to us belongs the Hereafter and the first "},{"type":"annotation","text":"[life]"},{"type":"text","text":"."}],"92:14":[{"type":"text","text":"So I have warned you of a Fire which is blazing."}]}