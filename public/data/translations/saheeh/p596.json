{"92:15":[{"type":"text","text":"None will "},{"type":"annotation","text":"[enter to]"},{"type":"text","text":" burn therein except the most wretched one"}],"92:16":[{"type":"text","text":"Who had denied and turned away."}],"92:17":[{"type":"text","text":"But the righteous one will avoid it"}],"92:18":[{"type":"annotation","text":"[He]"},{"type":"text","text":" who gives "},{"type":"annotation","text":"[from]"},{"type":"text","text":" his wealth to purify himself"}],"92:19":[{"type":"text","text":"And not "},{"type":"annotation","text":"[giving]"},{"type":"text","text":" for anyone who has "},{"type":"annotation","text":"[done him]"},{"type":"text","text":" a favor to be rewarded"},{"type":"footnote","id":"197777","label":"1"}],"92:20":[{"type":"text","text":"But only seeking the face "},{"type":"annotation","text":"[i.e., acceptance]"},{"type":"text","text":" of his Lord, Most High."}],"92:21":[{"type":"text","text":"And he is going to be satisfied."}],"93:1":[{"type":"text","text":"By the morning brightness"}],"93:2":[{"type":"text","text":"And "},{"type":"annotation","text":"[by]"},{"type":"text","text":" the night when it covers with darkness,"},{"type":"footnote","id":"197778","label":"1"}],"93:3":[{"type":"text","text":"Your Lord has not taken leave of you, "},{"type":"annotation","text":"[O Muḥammad]"},{"type":"text","text":", nor has He detested "},{"type":"annotation","text":"[you]"},{"type":"text","text":"."}],"93:4":[{"type":"text","text":"And the Hereafter is better for you than the first "},{"type":"annotation","text":"[life]"},{"type":"text","text":"."}],"93:5":[{"type":"text","text":"And your Lord is going to give you, and you will be satisfied."}],"93:6":[{"type":"text","text":"Did He not find you an orphan and give "},{"type":"annotation","text":"[you]"},{"type":"text","text":" refuge?"}],"93:7":[{"type":"text","text":"And He found you lost and guided "},{"type":"annotation","text":"[you]"},{"type":"text","text":","}],"93:8":[{"type":"text","text":"And He found you poor and made "},{"type":"annotation","text":"[you]"},{"type":"text","text":" self-sufficient."}],"93:9":[{"type":"text","text":"So as for the orphan, do not oppress "},{"type":"annotation","text":"[him]"},{"type":"text","text":"."}],"93:10":[{"type":"text","text":"And as for the petitioner,"},{"type":"footnote","id":"197779","label":"1"},{"type":"text","text":" do not repel "},{"type":"annotation","text":"[him]"},{"type":"text","text":"."}],"93:11":[{"type":"text","text":"But as for the favor of your Lord, report "},{"type":"annotation","text":"[it]"},{"type":"text","text":"."}],"94:1":[{"type":"text","text":"Did We not expand for you, "},{"type":"annotation","text":"[O Muḥammad]"},{"type":"text","text":", your breast?"},{"type":"footnote","id":"197780","label":"1"}],"94:2":[{"type":"text","text":"And We removed from you your burden"},{"type":"footnote","id":"197781","label":"1"}],"94:3":[{"type":"text","text":"Which had weighed upon your back"}],"94:4":[{"type":"text","text":"And raised high for you your repute."}],"94:5":[{"type":"text","text":"For indeed, with hardship "},{"type":"annotation","text":"[will be]"},{"type":"text","text":" ease "},{"type":"annotation","text":"[i.e., relief]"},{"type":"text","text":"."}],"94:6":[{"type":"text","text":"Indeed, with hardship "},{"type":"annotation","text":"[will be]"},{"type":"text","text":" ease."}],"94:7":[{"type":"text","text":"So when you have finished "},{"type":"annotation","text":"[your duties]"},{"type":"text","text":", then stand up "},{"type":"annotation","text":"[for worship]"},{"type":"text","text":"."}],"94:8":[{"type":"text","text":"And to your Lord direct "},{"type":"annotation","text":"[your]"},{"type":"text","text":" longing."}]}