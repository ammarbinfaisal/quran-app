# Quran.Foundation API credentials — request at https://api-docs.quran.foundation
# Copy to .env.local and fill in. Server-side only — never prefix with NEXT_PUBLIC_

# Pre-Production (Test) — limited data, all features enabled
QURAN_API_CLIENT_ID=
QURAN_API_CLIENT_SECRET=
QURAN_API_AUTH_URL=https://prelive-oauth2.quran.foundation

# Production (Live) — full content; used by scripts/fetch-tafsir-en.ts
QURAN_API_PROD_CLIENT_ID=
QURAN_API_PROD_CLIENT_SECRET=
QURAN_API_PROD_AUTH_URL=https://oauth2.quran.foundation
